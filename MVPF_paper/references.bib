@article{chofamily,
title = {Family labor supply and aggregate fluctuations},
journal = {Journal of Monetary Economics},
volume = {21},
number = {2},
pages = {233--245},
year = {1988},
issn = {0304-3932},
doi = {https://doi.org/10.1016/0304-3932(88)90031-1},
url = {https://www.sciencedirect.com/science/article/pii/0304393288900311},
author = {Jang-Ok Cho and Richard Rogerson},
abstract = {This paper considers an economy which is populated by a continuum of identical families consisting of two members. The two members have different productivities and the family faces a fixed utility cost if both members supply labor simultaneously. Although both family members have the same preferences, they display very different elasticities of labor supply. A real business cycle model is calibrated and it is seen that this cross-sectional heterogeneity results in interesting forms of aggregation bias.}
}

